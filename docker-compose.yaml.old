services:
  account-ui:
    build:
      context: .
      dockerfile: ./docker/Dockerfile
    ports:
      - "5173:5173"
    volumes:
      - .:/app
      - /app/node_modules
    environment:
      - CHOKIDAR_USEPOLLING=true
      - WATCHPACK_POLLING=true
      - VITE_ACCOUNT_API_HOST=${VITE_ACCOUNT_API_HOST}
      - VITE_ACCOUNT_API_PORT=${VITE_ACCOUNT_API_PORT}
    networks:
      ui_network:
        ipv4_address: 172.31.0.5

networks:
  ui_network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.31.0.0/16
